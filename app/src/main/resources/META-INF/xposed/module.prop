# Gself：纯 Hook 模块，无界面、无配置、无数据文件。
# 合并自 fcmself（推送修复）+ GooglePasswordManagerUnlock（通行密钥解限）+ GboardHook（剪贴板）。
#
# 代码按 libxposed API 102 编译（compileOnly io.github.libxposed:api:102.0.0），
# 最低要求 101（API 102 是纯增量，不改变 101 的行为）。
# 平台要求 Android 16+（API 36，minSdk 同样钉在 36）：只做新包，旧广播出口不实现。
# 入口类名写在 java_init.list（sumicya.fcmself.XposedMain），作用域见 scope.list：
# system（推送/通知/ColorOS）+ com.google.android.gms（通行密钥）+ Gboard（剪贴板）。
minApiVersion=101
targetApiVersion=102
# 作用域默认预选 system，用户仍可在 LSPosed 里改。
staticScope=false
# 拦截器自身抛出的异常由框架记录并当作「没有 hook」处理，不拖垮 system_server。
exceptionMode=protective
